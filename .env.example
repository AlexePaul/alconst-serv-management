# =============================================================================
# Alconst Serv Management – variabile de mediu
#
# Dezvoltare:  cp .env.example .env            (valorile de mai jos funcționează direct)
# Producție:   cp .env.example .env.production (completează secțiunea „Producție”)
#
# Nu comite niciodată fișiere .env reale în Git.
# =============================================================================

NODE_ENV=development

# Adresa publică a aplicației web. Folosită pentru protecția CSRF, cookie-uri și linkurile din emailuri.
APP_URL=http://localhost:3000

# Fusul orar în care se stabilește „azi” pentru termene și ora rezumatului pe email.
APP_TIMEZONE=Europe/Bucharest
# Cu câte zile în avans se generează task-urile din obligații.
TASK_HORIZON_DAYS=60

# --- API ---------------------------------------------------------------------
API_PORT=3001
DATABASE_URL=postgresql://alconst:alconst@127.0.0.1:5432/alconst
REDIS_URL=redis://127.0.0.1:6379

# Durata unei sesiuni (zile). Sesiunile folosite activ se prelungesc automat.
SESSION_TTL_DAYS=14
# Valabilitatea linkului de resetare a parolei (minute).
PASSWORD_RESET_TTL_MINUTES=60
# Numărul de reverse proxy-uri din fața API-ului (0 în dezvoltare, 1 în producție – Caddy).
TRUST_PROXY=0

# --- Documente ---------------------------------------------------------------
# Unde se păstrează fișierele încărcate: `local` (pe disc) sau `s3`.
# În dezvoltare, implicit pe disc, în `.data/files` din rădăcina proiectului.
FILES_STORAGE=local
# FILES_DIR=/cale/absolută/către/fișiere
# Dimensiunea maximă a unui fișier încărcat (MB).
MAX_UPLOAD_MB=25

# Dezactivează verificarea de versiune a CLI-ului Prisma (singura cerere către un serviciu extern).
CHECKPOINT_DISABLE=1

# --- Email (worker) ----------------------------------------------------------
# În dezvoltare: Mailpit din docker-compose.yml (interfață: http://localhost:8025).
# Dacă SMTP_HOST lipsește în dezvoltare, emailurile sunt doar afișate în logul worker-ului.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Alconst Serv <no-reply@alconst-serv.ro>

# --- Producție (docker-compose.prod.yml) -------------------------------------
# În producție, APP_URL, DATABASE_URL și REDIS_URL sunt construite automat din valorile de mai jos.
# APP_DOMAIN=app.alconst-serv.ro
# ACME_EMAIL=admin@alconst-serv.ro        # contact pentru certificatul Let's Encrypt
# POSTGRES_USER=alconst
# POSTGRES_PASSWORD=                      # generează cu: openssl rand -base64 32
# POSTGRES_DB=alconst
# REDIS_PASSWORD=                         # generează cu: openssl rand -base64 32
# Email prin Resend (SMTP) – detalii în docs/deploy.md
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=                          # cheia API Resend creată pentru aplicație
# MAIL_FROM=Alconst Serv <no-reply@alconst-serv.ro>
# Documente în Amazon S3 (bucket privat). Accesul se face prin rolul IAM al instanței EC2,
# fără chei de acces pe server. Alternativ: FILES_STORAGE=local (volum Docker pe server).
# FILES_STORAGE=s3
# S3_BUCKET=
# S3_REGION=eu-central-1
