// Schema bazei de date – Alconst Serv Management.
// Etapa 1 (Foundation): utilizatori, sesiuni, resetare parolă, jurnal de activitate.
// Etapa 2: clienți, responsabili, servicii, puncte de lucru, angajați, contracte și tarife.
// Entitățile pentru task-uri și documente se adaugă în etapele următoare.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

/// Utilizator intern al aplicației (personal Alconst Serv). Nu există înregistrare publică.
model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /// Stocat întotdeauna cu litere mici.
  email              String    @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               UserRole  @default(EMPLOYEE)
  isActive           Boolean   @default(true)
  /// Setat când un administrator stabilește o parolă temporară.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  activityLogs        ActivityLog[]
  clientAssignments   ClientAssignment[]
  createdClients      Client[]             @relation("ClientCreatedBy")

  @@map("users")
}

/// Sesiune de autentificare. În bază se păstrează doar hash-ul token-ului din cookie.
model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Token de resetare a parolei, de unică folosință. Se păstrează doar hash-ul.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Jurnal de activitate (audit log). Înregistrările nu se modifică și nu se șterg din aplicație.
model ActivityLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Utilizatorul care a efectuat acțiunea; null pentru acțiuni anonime (ex. login eșuat).
  userId      String?  @db.Uuid
  action      String
  entityType  String?
  entityId    String?
  entityLabel String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------------------------
// Clienți
// ---------------------------------------------------------------------------------------------

/// Companie pentru care Alconst Serv prestează servicii.
model Client {
  id                  String   @id @default(uuid(7)) @db.Uuid
  name                String
  /// Stocat fără spații, cu majuscule (ex. „RO12345678” sau „12345678”).
  cui                 String   @unique
  /// Nr. de ordine în Registrul Comerțului (ex. „J40/1234/2020”).
  tradeRegisterNumber String?
  address             String?
  contactPerson       String?
  email               String?
  phone               String?
  legalRepresentative String?
  notes               String?
  isActive            Boolean  @default(true)
  /// Text normalizat (fără diacritice, cu litere mici) folosit la căutare.
  searchText          String
  createdById         String?  @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  createdBy   User?              @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignments ClientAssignment[]
  services    ClientService[]
  locations   Location[]
  employees   Employee[]
  contracts   Contract[]

  @@index([name])
  @@map("clients")
}

/// Responsabilii unui client: utilizatorii interni care îl gestionează.
/// Un utilizator cu rolul „Angajat” vede și modifică doar clienții la care este responsabil.
model ClientAssignment {
  clientId  String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clientId, userId])
  @@index([userId])
  @@map("client_assignments")
}

/// Catalogul serviciilor oferite de firmă (SSM, PSI, instruiri etc.). Configurabil din aplicație.
model Service {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients ClientService[]
  fees    ContractFee[]

  @@map("services")
}

/// Serviciile prestate unui client.
model ClientService {
  clientId  String   @db.Uuid
  serviceId String   @db.Uuid
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([clientId, serviceId])
  @@index([serviceId])
  @@map("client_services")
}

/// Punct de lucru al unui client.
model Location {
  id        String   @id @default(uuid(7)) @db.Uuid
  clientId  String   @db.Uuid
  name      String
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@index([clientId])
  @@map("locations")
}

/// Angajat al unui client (nu utilizator al aplicației). Conține date personale.
model Employee {
  id         String    @id @default(uuid(7)) @db.Uuid
  clientId   String    @db.Uuid
  locationId String?   @db.Uuid
  firstName  String
  lastName   String
  position   String?
  hireDate   DateTime? @db.Date
  notes      String?
  isActive   Boolean   @default(true)
  /// Text normalizat folosit la căutare.
  searchText String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([lastName, firstName])
  @@map("employees")
}

enum ContractStatus {
  /// În pregătire – încă nu a intrat în vigoare.
  DRAFT
  ACTIVE
  /// Încheiat (expirat sau reziliat).
  ENDED
}

model Contract {
  id        String         @id @default(uuid(7)) @db.Uuid
  clientId  String         @db.Uuid
  number    String?
  startDate DateTime       @db.Date
  /// Null = contract pe perioadă nedeterminată.
  endDate   DateTime?      @db.Date
  status    ContractStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  client Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fees   ContractFee[]

  @@index([clientId])
  @@index([status, endDate])
  @@map("contracts")
}

/// Unitatea de timp la care se repetă un tarif. `VISIT` = la fiecare deplasare, `ONCE` = o singură dată.
enum FeeFrequencyUnit {
  WEEK
  MONTH
  YEAR
  VISIT
  ONCE
}

/// Un tarif convenit prin contract: cât încasează firma și cât de des.
/// Un contract poate avea mai multe tarife (ex. o sumă lunară și una suplimentară la 3 luni).
model ContractFee {
  id                String           @id @default(uuid(7)) @db.Uuid
  contractId        String           @db.Uuid
  serviceId         String?          @db.Uuid
  description       String?
  /// Suma în lei.
  amount            Decimal          @db.Decimal(12, 2)
  frequencyUnit     FeeFrequencyUnit
  /// La câte unități se repetă (ex. MONTH + 3 = la 3 luni). Ignorat pentru VISIT și ONCE.
  frequencyInterval Int              @default(1)
  /// Ordinea de afișare în cadrul contractului.
  position          Int              @default(0)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([serviceId])
  @@map("contract_fees")
}
