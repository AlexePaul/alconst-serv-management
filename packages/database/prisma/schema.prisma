// Schema bazei de date – Alconst Serv Management.
// Etapa 1 (Foundation): utilizatori, sesiuni, resetare parolă, jurnal de activitate.
// Etapa 2: clienți, responsabili, servicii, puncte de lucru, angajați, contracte și tarife.
// Etapa 3: obligații recurente, task-uri, notificări.
// Entitățile pentru documente se adaugă în etapa următoare.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

/// Utilizator intern al aplicației (personal Alconst Serv). Nu există înregistrare publică.
model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /// Stocat întotdeauna cu litere mici.
  email              String    @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               UserRole  @default(EMPLOYEE)
  isActive           Boolean   @default(true)
  /// Setat când un administrator stabilește o parolă temporară.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  activityLogs         ActivityLog[]
  clientAssignments    ClientAssignment[]
  createdClients       Client[]                @relation("ClientCreatedBy")
  assignedObligations  Obligation[]            @relation("ObligationAssignee")
  createdObligations   Obligation[]            @relation("ObligationCreatedBy")
  assignedTasks        Task[]                  @relation("TaskAssignee")
  createdTasks         Task[]                  @relation("TaskCreatedBy")
  completedTasks       Task[]                  @relation("TaskCompletedBy")
  sheetsCompletedTasks Task[]                  @relation("TaskSheetsCompletedBy")
  notifications        Notification[]
  transfersFrom        ClientTransferRequest[] @relation("TransferFrom")
  transfersTo          ClientTransferRequest[] @relation("TransferTo")
  transfersInitiated   ClientTransferRequest[] @relation("TransferInitiatedBy")
  notificationSettings NotificationSettings?

  @@map("users")
}

/// Sesiune de autentificare. În bază se păstrează doar hash-ul token-ului din cookie.
model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Token de resetare a parolei, de unică folosință. Se păstrează doar hash-ul.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Jurnal de activitate (audit log). Înregistrările nu se modifică și nu se șterg din aplicație.
model ActivityLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Utilizatorul care a efectuat acțiunea; null pentru acțiuni anonime (ex. login eșuat).
  userId      String?  @db.Uuid
  action      String
  entityType  String?
  entityId    String?
  entityLabel String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------------------------
// Clienți
// ---------------------------------------------------------------------------------------------

/// Companie pentru care Alconst Serv prestează servicii.
model Client {
  id                  String   @id @default(uuid(7)) @db.Uuid
  name                String
  /// Stocat fără spații, cu majuscule (ex. „RO12345678” sau „12345678”).
  cui                 String   @unique
  /// Nr. de ordine în Registrul Comerțului (ex. „J40/1234/2020”).
  tradeRegisterNumber String?
  address             String?
  contactPerson       String?
  email               String?
  phone               String?
  legalRepresentative String?
  notes               String?
  isActive            Boolean  @default(true)
  /// Text normalizat (fără diacritice, cu litere mici) folosit la căutare.
  searchText          String
  createdById         String?  @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  createdBy        User?                   @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignments      ClientAssignment[]
  services         ClientService[]
  locations        Location[]
  employees        Employee[]
  contracts        Contract[]
  obligations      Obligation[]
  tasks            Task[]
  transferRequests ClientTransferRequest[]

  @@index([name])
  @@map("clients")
}

/// Responsabilii unui client: utilizatorii interni care îl gestionează.
/// Un utilizator cu rolul „Angajat” vede și modifică doar clienții la care este responsabil.
model ClientAssignment {
  clientId  String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clientId, userId])
  @@index([userId])
  @@map("client_assignments")
}

/// Catalogul serviciilor oferite de firmă (SSM, PSI, instruiri etc.). Configurabil din aplicație.
model Service {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients ClientService[]
  fees    ContractFee[]

  @@map("services")
}

/// Serviciile prestate unui client.
model ClientService {
  clientId  String   @db.Uuid
  serviceId String   @db.Uuid
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([clientId, serviceId])
  @@index([serviceId])
  @@map("client_services")
}

/// Punct de lucru al unui client.
model Location {
  id        String   @id @default(uuid(7)) @db.Uuid
  clientId  String   @db.Uuid
  name      String
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employees   Employee[]
  obligations Obligation[]
  tasks       Task[]

  @@index([clientId])
  @@map("locations")
}

/// Angajat al unui client (nu utilizator al aplicației). Conține date personale.
model Employee {
  id         String    @id @default(uuid(7)) @db.Uuid
  clientId   String    @db.Uuid
  locationId String?   @db.Uuid
  firstName  String
  lastName   String
  position   String?
  hireDate   DateTime? @db.Date
  notes      String?
  isActive   Boolean   @default(true)
  /// Text normalizat folosit la căutare.
  searchText String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([lastName, firstName])
  @@map("employees")
}

enum ContractStatus {
  /// În pregătire – încă nu a intrat în vigoare.
  DRAFT
  ACTIVE
  /// Încheiat (expirat sau reziliat).
  ENDED
}

model Contract {
  id        String         @id @default(uuid(7)) @db.Uuid
  clientId  String         @db.Uuid
  number    String?
  startDate DateTime       @db.Date
  /// Null = contract pe perioadă nedeterminată.
  endDate   DateTime?      @db.Date
  status    ContractStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  client Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fees   ContractFee[]

  @@index([clientId])
  @@index([status, endDate])
  @@map("contracts")
}

/// Unitatea de timp la care se repetă un tarif. `VISIT` = la fiecare deplasare, `ONCE` = o singură dată.
enum FeeFrequencyUnit {
  WEEK
  MONTH
  YEAR
  VISIT
  ONCE
}

/// Un tarif convenit prin contract: cât încasează firma și cât de des.
/// Un contract poate avea mai multe tarife (ex. o sumă lunară și una suplimentară la 3 luni).
model ContractFee {
  id                String           @id @default(uuid(7)) @db.Uuid
  contractId        String           @db.Uuid
  serviceId         String?          @db.Uuid
  description       String?
  /// Suma în lei.
  amount            Decimal          @db.Decimal(12, 2)
  frequencyUnit     FeeFrequencyUnit
  /// La câte unități se repetă (ex. MONTH + 3 = la 3 luni). Ignorat pentru VISIT și ONCE.
  frequencyInterval Int              @default(1)
  /// Ordinea de afișare în cadrul contractului.
  position          Int              @default(0)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([serviceId])
  @@map("contract_fees")
}

// ---------------------------------------------------------------------------------------------
// Obligații și task-uri
// ---------------------------------------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

/// Felul activității. `VISIT` = deplasare la client (mers acolo, completat fișele).
enum TaskKind {
  GENERAL
  VISIT
}

enum RecurrenceUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

/// Activitate recurentă care trebuie realizată (ex. deplasare lunară, instruire la 3 luni).
/// Din ea se generează automat task-uri concrete, cu termen și responsabil.
/// Frecvența este configurată per obligație; nimic nu este fixat în cod.
model Obligation {
  id                 String         @id @default(uuid(7)) @db.Uuid
  title              String
  description        String?
  kind               TaskKind       @default(GENERAL)
  clientId           String?        @db.Uuid
  locationId         String?        @db.Uuid
  /// Responsabilul implicit al task-urilor generate.
  assigneeId         String?        @db.Uuid
  priority           TaskPriority   @default(NORMAL)
  recurrenceUnit     RecurrenceUnit
  /// La câte unități se repetă (ex. MONTH + 3 = la 3 luni).
  recurrenceInterval Int            @default(1)
  /// Primul termen; următoarele se calculează de la această dată.
  startDate          DateTime       @db.Date
  /// După această dată nu se mai generează task-uri. Null = fără sfârșit.
  endDate            DateTime?      @db.Date
  /// Intervalul orar estimat (`HH:mm`), copiat în task-urile generate. Opțional.
  startTime          String?
  endTime            String?
  isActive           Boolean        @default(true)
  searchText         String
  createdById        String?        @db.Uuid
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  client    Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  location  Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignee  User?     @relation("ObligationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("ObligationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([clientId])
  @@index([isActive])
  @@map("obligations")
}

/// O execuție concretă: ce trebuie făcut, până când și de către cine.
model Task {
  id                  String       @id @default(uuid(7)) @db.Uuid
  title               String
  description         String?
  /// Observații adăugate pe parcursul execuției.
  notes               String?
  kind                TaskKind     @default(GENERAL)
  status              TaskStatus   @default(TODO)
  priority            TaskPriority @default(NORMAL)
  dueDate             DateTime     @db.Date
  /// Intervalul orar estimat de responsabil (`HH:mm`). Opțional: „de la” fără „până la” este permis.
  startTime           String?
  endTime             String?
  clientId            String?      @db.Uuid
  locationId          String?      @db.Uuid
  obligationId        String?      @db.Uuid
  /// Apariția din obligație pe care o reprezintă task-ul. Împreună cu `obligationId` garantează
  /// că aceeași apariție nu este generată de două ori, nici la rulări simultane.
  occurrenceDate      DateTime?    @db.Date
  assigneeId          String?      @db.Uuid
  createdById         String?      @db.Uuid
  completedAt         DateTime?
  completedById       String?      @db.Uuid
  /// Doar pentru deplasări: momentul în care s-a confirmat că fișele au fost completate.
  /// Aplicația ține doar evidența; fișele propriu-zise nu sunt stocate.
  sheetsCompletedAt   DateTime?
  sheetsCompletedById String?      @db.Uuid
  searchText          String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  client            Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  location          Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  obligation        Obligation?    @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  assignee          User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy         User?          @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy       User?          @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  sheetsCompletedBy User?          @relation("TaskSheetsCompletedBy", fields: [sheetsCompletedById], references: [id], onDelete: SetNull)
  notifications     Notification[]

  @@unique([obligationId, occurrenceDate])
  @@index([status, dueDate])
  @@index([assigneeId, status, dueDate])
  @@index([clientId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------------------------
// Notificări
// ---------------------------------------------------------------------------------------------

/// Notificare în aplicație pentru un utilizator.
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String?
  taskId    String?   @db.Uuid
  /// Pagina din aplicație la care trimite notificarea, atunci când nu se referă la un task.
  link      String?
  /// Cheie care identifică unic motivul notificării (ex. „due-today:<task>:<user>”).
  /// Constrângerea de unicitate garantează că aceeași notificare nu este creată de două ori.
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Preferințele de notificare ale unui utilizator. Fără rând = valorile implicite.
model NotificationSettings {
  userId           String    @id @db.Uuid
  emailEnabled     Boolean   @default(true)
  /// Cu câte zile înainte de termen se trimite reamintirea (0 = dezactivat).
  remindDaysBefore Int       @default(3)
  /// Ultima zi în care a fost trimis rezumatul pe email (cel mult unul pe zi).
  lastDigestDate   DateTime? @db.Date
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// ---------------------------------------------------------------------------------------------
// Predarea clienților între colegi
// ---------------------------------------------------------------------------------------------

enum TransferRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// Cerere de predare definitivă a unui client de la un responsabil la altul.
/// Poate fi inițiată de oricare dintre cei doi și are efect doar după acordul celuilalt.
/// (Administratorii pot transfera direct, fără cerere.)
model ClientTransferRequest {
  id            String                @id @default(uuid(7)) @db.Uuid
  clientId      String                @db.Uuid
  /// Responsabilul actual, care predă clientul.
  fromUserId    String                @db.Uuid
  /// Colegul care preia clientul.
  toUserId      String                @db.Uuid
  initiatedById String                @db.Uuid
  status        TransferRequestStatus @default(PENDING)
  createdAt     DateTime              @default(now())
  resolvedAt    DateTime?
  resolvedById  String?               @db.Uuid

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  from        User   @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to          User   @relation("TransferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  initiatedBy User   @relation("TransferInitiatedBy", fields: [initiatedById], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([clientId, status])
  @@map("client_transfer_requests")
}
